# ════════════════════════════════════════════════════════════════
# Filmora Movie — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════

# ─── TMDB ────────────────────────────────────────────────────────
# Get your free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key
# Read Access Token (v4 Bearer) — optional
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token

# ─── Google OAuth ────────────────────────────────────────────────
# Create a project at: https://console.cloud.google.com/
# 1. Enable "Google+ API" and "Google Identity API"
# 2. Create OAuth 2.0 credentials (Web application)
# 3. Add authorized redirect URIs:
#    - http://localhost:4321/api/auth/google/callback  (dev)
#    - https://filmoramovie.com/api/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/google/callback

# ─── Email (app password for transactional mail) ─────────────────
EMAIL_USER=you@example.com
EMAIL_APP_PASSWORD=your_email_app_password

# ─── Database ────────────────────────────────────────────────────
# Path to the SQLite database file.
# Default: ./filmora.db (project root, auto-created on first run)
# Vercel Note: SQLite won't persist across serverless function invocations.
# For production, consider Turso (https://turso.tech) or Neon Postgres.
DB_PATH=./filmora.db

# ─── Site ────────────────────────────────────────────────────────
# Public site URL (used for OAuth redirect URI + OG tags)
PUBLIC_SITE_URL=http://localhost:4321

# ─── Optional: Analytics ─────────────────────────────────────────
# Only enabled if user opts in to analytics cookies
# PLAUSIBLE_DOMAIN=filmoramovie.com

# ─── nexos.ai Gateway ───────────────────────────────────────────
# Server-only key used by the AI mood recommendation endpoint.
NexS_api=your_nexos_api_key

# ─── CodeSpecter Embed API ───────────────────────────────────────
# Server-only movie embed key. Get one at https://api.codespecters.com/api
# (keys expire ~30 days after issuance — rotate before then).
EMBED_API_KEY=your_codespecter_api_key
