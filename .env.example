
DB_PATH=./filmora.db

# ─── Site ────────────────────────────────────────────────────────
# Public site URL (used for OAuth redirect URI + OG tags)
PUBLIC_SITE_URL=http://localhost:4321


# ════════════════════════════════════════════════════════════════
TMDB_API_KEY=e8278bd7a1c03b9c0817e04e90b7a4c3
# ─── TMDB ────────────────────────────────────────────────────────
# API Key (v3) — used as ?api_key= query param (src/lib/tmdb.ts, api/search.ts)
TMDB_API_KEY=DB_PATH=./filmora.db

# ─── Site ────────────────────────────────────────────────────────
# Public site URL (used for OAuth redirect URI + OG tags)

# ─── Google OAuth ────────────────────────────────────────────────
# Used by src/lib/oauth.ts for Google sign-in.
GOOGLE_CLIENT_ID=157300060933-jvifsion0fq80tdi9ph8r9jkhnogcqm2.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/google/callback

# ─── nexos.ai Gateway ───────────────────────────────────────────
# Server-only key used by the AI mood recommendation endpoint (api/mood.ts,
# read via Astro.locals.runtime.env.NexS_api).
NexS_api=nx_4a1d3c31bf26e0aae6f04909e376b608

# ─── CodeSpecter Embed API ───────────────────────────────────────
# Server-only movie/series embed key used by src/lib/embed.ts.
# Get one at https://api.codespecters.com/api
# (keys expire ~30 days after issuance — rotate before then).
EMBED_API_KEY=nx_4a1d3c31bf26e0aae6f04909e376b608

# ─── Magic Link (Passwordless Auth) ─────────────────────────────
# Resend (https://resend.com) API key for sending magic link emails.
# Sign up free → Settings → API Keys → Create.
RESEND_API_KEY=your_resend_api_key_here

# Verified sender email address (must match a domain verified in Resend).
# E.g. noreply@filmoramovie.com or Filmora <noreply@filmoramovie.com>
FROM_EMAIL=Filmora <bjjbkjbkjb@gmail.com>

# ─── RapidAPI (Streaming Availability) ──────────────────────────
# Optional. Used by streaming-availability.p.rapidapi.com metadata lookups.
RAPIDAPI_KEY=61779b79eamshfff668ac4e592f9p19aa3ajsn0d4bd96a9c67

# ─── SuperEmbed ─────────────────────────────────────────────────
# Preferred upstream server for getsuperembed.link (0 = no preference).
SUPEREMBED_PREFERRED_SERVER=0
