---
// src/pages/series.astro — /series browse page
import Layout from '../layouts/Layout.astro';
import PosterCard from '../components/PosterCard.astro';
import FilterPanel from '../components/react/FilterPanel';
import HeroCarousel from '../components/react/HeroCarousel';
import { discoverSeries, getSeriesGenres, getTrendingSeries, buildHeroSlides } from '../lib/tmdb';
import type { TMDBSeriesBase } from '../lib/types';

const url = Astro.url;
const page = parseInt(url.searchParams.get('page') ?? '1');
const sortBy = url.searchParams.get('sort') ?? 'popularity.desc';
const genresParam = url.searchParams.get('genres') ?? '';
const yearFrom = url.searchParams.get('year_from') ?? '';
const yearTo = url.searchParams.get('year_to') ?? '';
const minRating = url.searchParams.get('min_rating') ?? '';
const lang = url.searchParams.get('lang') ?? '';

let series: TMDBSeriesBase[] = [];
let totalPages = 1;
let totalResults = 0;
let genres: { id: number; name: string }[] = [];
let error: string | null = null;
let heroSlides: Awaited<ReturnType<typeof buildHeroSlides>> = [];

try {
  // Fetch grid series + genres + top trending series for the hero in parallel.
  const [seriesRes, genresRes, trendingRes] = await Promise.all([
    discoverSeries({
      page,
      sort_by: sortBy,
      with_genres: genresParam || undefined,
      'first_air_date.gte': yearFrom ? `${yearFrom}-01-01` : undefined,
      'first_air_date.lte': yearTo ? `${yearTo}-12-31` : undefined,
      'vote_average.gte': minRating ? parseFloat(minRating) : undefined,
      with_original_language: lang || undefined,
    }),
    getSeriesGenres(),
    getTrendingSeries('week'),
  ]);
  series = seriesRes.results;
  totalPages = Math.min(seriesRes.total_pages, 500);
  totalResults = seriesRes.total_results;
  genres = genresRes.genres;

  // Build enriched hero slides (series only, top 5).
  heroSlides = await buildHeroSlides(trendingRes.results, 'tv', 5);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load series';
}

// Pagination helpers
const seriesPageCount = Math.min(7, totalPages);
const seriesPageNumbers: number[] = Array.from({ length: seriesPageCount }, (_, i) => {
  if (totalPages <= 7) return i + 1;
  if (page <= 4) return i + 1;
  if (page + 3 >= totalPages) return totalPages - 6 + i;
  return page - 3 + i;
});

function pageUrl(p: number) {
  const params = new URLSearchParams(url.searchParams);
  params.set('page', String(p));
  return `/series?${params.toString()}`;
}

const showPrev = page > 1;
const showNext = page < totalPages;
const initialFilters = {
  genres: genresParam ? genresParam.split(',').map(Number) : [],
  sortBy,
  yearFrom,
  yearTo,
  minRating,
  language: lang,
};
---

<Layout title="Series — Browse & Find Where to Watch">

  {/* ── Series-only hero carousel (Top 5 Trending Series) ── */}
  {heroSlides.length > 0 && (
    <HeroCarousel client:load slides={heroSlides} label="Top 5 Series" />
  )}

  <div class="container browse-page">
    <div class="browse-header">
      <h1 class="browse-title">Series</h1>
      {!error && (
        <p class="browse-count">{totalResults.toLocaleString()} shows</p>
      )}
    </div>

    <FilterPanel
      client:load
      genres={genres}
      initialFilters={initialFilters}
      mediaType="tv"
    />

    {error ? (
      <div class="browse-error">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <p class="browse-error-msg">Failed to load series. Please try again.</p>
        <a href="/series" class="btn btn-secondary">Reset filters</a>
      </div>
    ) : series.length === 0 ? (
      <div class="browse-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <h2 class="browse-empty-title">No series found</h2>
        <p class="browse-empty-desc">Try adjusting your filters or <a href="/series" class="browse-empty-link">clear all</a>.</p>
      </div>
    ) : (
      <>
        <div class="poster-grid" role="list" aria-label="Series grid" data-reveal>
          {series.map((show) => (
            <div role="listitem">
              <PosterCard
                id={show.id}
                title={show.name}
                mediaType="tv"
                posterPath={show.poster_path}
                backdropPath={show.backdrop_path}
                releaseDate={show.first_air_date}
                voteAverage={show.vote_average}
                overview={show.overview}
              />
            </div>
          ))}
        </div>

        {totalPages > 1 && (
          <nav class="pagination" aria-label="Pagination">
            {showPrev && (
              <a href={pageUrl(page - 1)} class="btn btn-secondary pagination-btn" aria-label="Previous page">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m15 18-6-6 6-6"/>
                </svg>
                Previous
              </a>
            )}
            <div class="pagination-pages" aria-label="Page numbers">
              {seriesPageNumbers.map((p) => (
                <a
                  href={pageUrl(p)}
                  class={`pagination-page ${p === page ? 'pagination-page--active' : ''}`}
                  aria-current={p === page ? 'page' : undefined}
                  aria-label={`Page ${p}`}
                >
                  {p}
                </a>
              ))}
            </div>
            {showNext && (
              <a href={pageUrl(page + 1)} class="btn btn-secondary pagination-btn" aria-label="Next page">
                Next
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </a>
            )}
          </nav>
        )}
      </>
    )}
  </div>
</Layout>

<style>
  /* No top padding on browse-page — hero carousel sits immediately below the navbar */
  .browse-page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .browse-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .browse-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: var(--letter-spacing-tight);
    margin: 0;
  }

  .browse-count { font-size: var(--font-size-sm); color: var(--color-text-3); margin: 0; }

  .poster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    column-gap: 1.5rem;
    row-gap: 2rem;
  }

  @media (min-width: 640px) {
    .poster-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      column-gap: 1.75rem;
      row-gap: 2.25rem;
    }
  }

  @media (min-width: 1024px) {
    .poster-grid {
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      column-gap: 2rem;
      row-gap: 2.5rem;
    }
  }

  .browse-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 4rem 0;
    text-align: center;
    color: var(--color-text-3);
  }

  .browse-error-msg { font-size: var(--font-size-base); color: var(--color-text-2); margin: 0; }

  .browse-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 5rem 0;
    text-align: center;
    color: var(--color-text-3);
  }

  .browse-empty-title { font-size: var(--font-size-xl); font-weight: 600; color: var(--color-text); margin: 0; }
  .browse-empty-desc { font-size: var(--font-size-sm); color: var(--color-text-2); margin: 0; }
  .browse-empty-link { color: var(--color-accent-from); text-decoration: none; }
  .browse-empty-link:hover { text-decoration: underline; }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .pagination-btn { display: flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; }
  .pagination-pages { display: flex; gap: 0.25rem; }

  .pagination-page {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-2);
    text-decoration: none;
    transition: all var(--duration-fast) ease;
    border: 1px solid transparent;
  }

  .pagination-page:hover {
    color: var(--color-text);
    background: var(--color-surface-2);
    border-color: var(--color-border);
  }

  .pagination-page--active {
    background: linear-gradient(135deg, var(--color-accent-from), var(--color-accent-to));
    color: #fff;
    border-color: transparent;
    pointer-events: none;
  }
</style>
