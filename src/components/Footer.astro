---
// Footer.astro — Apple.com-style footer: fine print · multi-column link grid · bottom legal bar
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Browse',
    links: [
      { label: 'Movies', href: '/movies' },
      { label: 'Series', href: '/series' },
      { label: 'Anime', href: '/anime' },
      { label: 'Trending', href: '/movies?sort=popularity.desc' },
      { label: 'Top Rated', href: '/movies?sort=vote_average.desc' },
    ],
  },
  {
    title: 'Platforms',
    links: [
      { label: 'Netflix', href: '/netflix' },
      { label: 'Prime Video', href: '/prime' },
      { label: 'Apple TV+', href: '/appletv' },
    ],
  },
  {
    title: 'Genres',
    links: [
      { label: 'Action', href: '/movies?genres=28' },
      { label: 'Comedy', href: '/movies?genres=35' },
      { label: 'Drama', href: '/movies?genres=18' },
      { label: 'Horror', href: '/movies?genres=27' },
      { label: 'Sci-Fi', href: '/movies?genres=878' },
      { label: 'Romance', href: '/movies?genres=10749' },
    ],
  },
  {
    title: 'Your Account',
    links: [
      { label: 'Watchlist', href: '/watchlist' },
      { label: 'Profile', href: '/profile' },
      { label: 'Search', href: '/search' },
      { label: 'Sign In', href: '/login' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Contact', href: '/contact' },
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms & Conditions', href: '/terms' },
    ],
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="footer-container">

    <!-- Fine print -->
    <div class="footer-fineprint">
      <p>
        Filmora Movie is a discovery and tracking platform. We do not host, upload, or stream any
        video content. Every title links to its official, licensed streaming provider.
      </p>
      <p>
        Movie and TV metadata is provided by
        <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer">The Movie Database (TMDB)</a>.
        This product uses the TMDB API but is not endorsed or certified by TMDB. Watch-provider data
        sourced from JustWatch. All trademarks and logos are the property of their respective owners.
      </p>
    </div>

    <!-- Link grid -->
    <nav class="footer-grid" aria-label="Footer">
      {columns.map((col) => (
        <div class="footer-col">
          <h3 class="footer-col-title">{col.title}</h3>
          <ul class="footer-col-list" role="list">
            {col.links.map((l) => (
              <li><a href={l.href} class="footer-col-link">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <!-- Bottom bar -->
    <div class="footer-bar">
      <p class="footer-copy">Copyright &copy; {year} Filmora Movie. All rights reserved.</p>

      <div class="footer-bar-links">
        <a href="/privacy">Privacy Policy</a>
        <span class="footer-bar-sep" aria-hidden="true">|</span>
        <a href="/terms">Terms &amp; Conditions</a>
        <span class="footer-bar-sep" aria-hidden="true">|</span>
        <a href="/contact">Contact</a>
        <span class="footer-bar-sep" aria-hidden="true">|</span>
        <a href="/about">About</a>
      </div>

      <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer" class="footer-region">
        Data by TMDB
      </a>
    </div>

  </div>
</footer>

<style>
  .footer {
    background: transparent;
    margin-top: 5rem;
    font-size: 12px;
    line-height: 1.45;
    position: relative;
  }
  /* Soft gradient lift instead of a hard divider line — the footer
     melts up out of the page rather than starting at a border. */
  .footer::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100%;
    background: linear-gradient(to bottom,
      transparent,
      color-mix(in srgb, var(--color-surface) 55%, transparent) 55%,
      color-mix(in srgb, var(--color-surface) 80%, transparent));
    pointer-events: none;
    z-index: -1;
  }
  html[data-theme="light"] .footer::before {
    background: linear-gradient(to bottom,
      transparent,
      color-mix(in srgb, #ffffff 55%, transparent) 55%,
      color-mix(in srgb, #ffffff 85%, transparent));
  }

  .footer-container {
    max-width: 1024px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 2rem;
  }
  @media (min-width: 768px) {
    .footer-container { padding: 1.5rem 2.5rem 2rem; }
  }

  /* ── Fine print ── */
  .footer-fineprint {
    padding: 0.5rem 0 1.25rem;
  }
  .footer-fineprint p {
    color: rgba(255,255,255,0.4);
    margin: 0 0 0.5rem;
    font-size: 12px;
    line-height: 1.5;
  }
  .footer-fineprint p:last-child { margin-bottom: 0; }
  html[data-theme="light"] .footer-fineprint p { color: #6e6e73; }
  .footer-fineprint a {
    color: rgba(255,255,255,0.6);
    text-decoration: none;
  }
  .footer-fineprint a:hover { text-decoration: underline; }
  html[data-theme="light"] .footer-fineprint a { color: #424245; }

  /* ── Link grid ── */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 1.5rem;
    padding: 1.75rem 0;
  }
  @media (min-width: 640px) { .footer-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .footer-grid { grid-template-columns: repeat(5, 1fr); } }

  .footer-col-title {
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }
  html[data-theme="light"] .footer-col-title { color: #1d1d1f; }

  .footer-col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-col-link {
    font-size: 12px;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-col-link:hover { color: #fff; text-decoration: underline; }
  html[data-theme="light"] .footer-col-link { color: #6e6e73; }
  html[data-theme="light"] .footer-col-link:hover { color: #1d1d1f; }

  /* ── Bottom bar ── */
  .footer-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding-top: 1.25rem;
  }
  .footer-copy {
    color: rgba(255,255,255,0.4);
    margin: 0;
    font-size: 12px;
  }
  html[data-theme="light"] .footer-copy { color: #6e6e73; }

  .footer-bar-links {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }
  .footer-bar-links a {
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    font-size: 12px;
    transition: color 0.15s ease;
    white-space: nowrap;
  }
  .footer-bar-links a:hover { color: #fff; text-decoration: underline; }
  html[data-theme="light"] .footer-bar-links a { color: #6e6e73; }
  html[data-theme="light"] .footer-bar-links a:hover { color: #1d1d1f; }
  .footer-bar-sep { color: rgba(255,255,255,0.2); font-size: 11px; }
  html[data-theme="light"] .footer-bar-sep { color: rgba(0,0,0,0.2); }

  .footer-region {
    margin-left: auto;
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    font-size: 12px;
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 6px;
    transition: border-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .footer-region:hover { color: #fff; border-color: rgba(255,255,255,0.3); }
  html[data-theme="light"] .footer-region { color: #6e6e73; border-color: rgba(0,0,0,0.15); }
  html[data-theme="light"] .footer-region:hover { color: #1d1d1f; border-color: rgba(0,0,0,0.35); }

  @media (max-width: 640px) {
    .footer-bar { flex-direction: column; align-items: flex-start; }
    .footer-region { margin-left: 0; }
  }
</style>
