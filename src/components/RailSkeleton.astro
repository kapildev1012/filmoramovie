---
// RailSkeleton.astro — Shimmer placeholder shown while a rail's data isn't ready.
// Mirrors MovieRail's layout so there is no layout shift when real data swaps in.
export interface Props {
  /** Number of placeholder cards. */
  count?: number;
  /** Wide (backdrop) cards instead of poster cards. */
  wide?: boolean;
  /** Show a title placeholder bar. */
  withTitle?: boolean;
}
const { count = 8, wide = false, withTitle = true } = Astro.props;
const cards = Array.from({ length: count });
---

<section class="rail" aria-hidden="true">
  <div class="container">
    {withTitle && (
      <div class="rail-header">
        <div class="skeleton skel-title"></div>
      </div>
    )}
    <div class="scroll-rail">
      {cards.map(() => (
        <div class={`skel-card ${wide ? 'skel-card--wide' : ''}`}>
          <div class="skeleton skel-poster"></div>
          <div class="skeleton skel-line skel-line--lg"></div>
          <div class="skeleton skel-line skel-line--sm"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rail { margin-bottom: var(--section-gap, 3rem); }
  .rail-header { margin-bottom: 1rem; }
  .skel-title { width: 200px; height: 24px; border-radius: var(--radius-md); }
  .skel-card { flex-shrink: 0; width: 160px; }
  .skel-card--wide { width: 280px; }
  .skel-poster {
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-lg);
    margin-bottom: 0.5rem;
  }
  .skel-card--wide .skel-poster { aspect-ratio: 16 / 9; }
  .skel-line { height: 12px; border-radius: var(--radius-sm); margin-top: 6px; }
  .skel-line--lg { width: 80%; }
  .skel-line--sm { width: 50%; }
</style>
