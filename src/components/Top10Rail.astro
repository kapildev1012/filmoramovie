---
// Top10Rail.astro — Netflix-style "Top 10 Today"
// The big rank number sits BEHIND the poster card (z-index: 0 vs z-index: 1).
// The poster overlaps the left half of the number, exactly like net77.cc.
export interface Props {
  title: string;
  viewAllHref?: string;
  items: Array<{
    id: number;
    title?: string;
    name?: string;
    poster_path?: string | null;
    backdrop_path?: string | null;
    vote_average?: number;
    media_type?: 'movie' | 'tv';
  }>;
  mediaType?: 'movie' | 'tv';
  accentColor?: string;
}

const { title, viewAllHref, items, mediaType = 'tv', accentColor = '#e50914' } = Astro.props;
const top10 = items.slice(0, 10);
---

<section class="t10-rail" aria-label={title}>
  <div class="container">
    <div class="t10-header">
      <div class="t10-title-row">
        <div class="t10-accent-bar" style={`background:${accentColor}`}></div>
        <h2 class="t10-title">{title}</h2>
      </div>
      {viewAllHref && (
        <a href={viewAllHref} class="t10-view-all" aria-label={`See all ${title}`}>
          See all
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      )}
    </div>

    <div class="t10-viewport" data-t10-rail>
      {/* Items duplicated for seamless infinite scroll */}
      <div class="t10-track" role="list" aria-label={`${title} list`} data-t10-track>
        {[...top10, ...top10].map((item, i) => {
          const resolvedType = (item.media_type as 'movie' | 'tv') ?? mediaType;
          const href = `/${resolvedType === 'movie' ? 'movie' : 'series'}/${item.id}`;
          const resolvedTitle = item.title ?? item.name ?? '';
          const poster = item.poster_path
            ? `https://image.tmdb.org/t/p/w342${item.poster_path}`
            : null;
          const rating = item.vote_average ? item.vote_average.toFixed(1) : null;
          const rank = (i % top10.length) + 1;
          return (
            <div class="t10-item" role="listitem">
              {/* ── Number sits at z-index 0, BEHIND the card ── */}
              <span class="t10-rank" aria-hidden="true">{rank}</span>

              {/* ── Poster at z-index 1, overlaps the right half of the number ── */}
              <a href={href} class="t10-card" aria-label={resolvedTitle} tabindex={i < top10.length ? 0 : -1}>
                {poster ? (
                  <img
                    src={poster}
                    alt={resolvedTitle}
                    class="t10-poster"
                    loading="lazy"
                    decoding="async"
                    width="160"
                    height="240"
                  />
                ) : (
                  <div class="t10-poster t10-poster--empty" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="m7 2 0 20M17 2v20M2 12h20M2 7h5M2 17h5M17 17h5M17 7h5"/></svg>
                  </div>
                )}
                <div class="t10-card-overlay">
                  {rating && (
                    <span class="t10-rating">
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {rating}
                    </span>
                  )}
                  <span class="t10-name">{resolvedTitle}</span>
                </div>
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  // Continuous left-to-right auto-scroll roller for Top 10 rails.
  // Items are duplicated in markup for seamless looping.
  // Pauses on hover/touch so users can still interact.
  type T10El = HTMLElement & { _t10Init?: boolean };

  function initT10(viewport: T10El) {
    if (viewport._t10Init) return;
    viewport._t10Init = true;

    const track = viewport.querySelector<HTMLElement>('[data-t10-track]');
    if (!track) return;

    const SPEED = 0.6; // px per frame (~36px/s at 60fps)
    let paused = false;
    let raf = 0;

    function step() {
      if (!paused) {
        const max = track!.scrollWidth / 2;
        viewport.scrollLeft += SPEED;
        if (viewport.scrollLeft >= max) {
          viewport.scrollLeft -= max;
        }
      }
      raf = requestAnimationFrame(step);
    }

    raf = requestAnimationFrame(step);

    const pause = () => { paused = true; };
    const resume = () => { paused = false; };

    viewport.addEventListener('mouseenter', pause);
    viewport.addEventListener('mouseleave', resume);
    viewport.addEventListener('touchstart', pause, { passive: true });
    viewport.addEventListener('touchend', resume);

    // Cleanup on Astro page transitions
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      viewport.removeEventListener('mouseenter', pause);
      viewport.removeEventListener('mouseleave', resume);
      viewport.removeEventListener('touchstart', pause);
      viewport.removeEventListener('touchend', resume);
    }, { once: true });
  }

  function initAll() {
    // Skip if user prefers reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<T10El>('[data-t10-rail]').forEach(initT10);
  }
  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>

<style>
  .t10-rail { margin-bottom: 1rem; }

  .t10-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding: 0 0.25rem;
  }
  .t10-title-row { display: flex; align-items: center; gap: 0.625rem; }
  .t10-accent-bar { width: 4px; height: 1.25rem; border-radius: 2px; flex-shrink: 0; }
  .t10-title {
    font-size: clamp(0.9375rem, 1.8vw, 1.25rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.2;
  }
  .t10-view-all {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.8rem; font-weight: 600; color: rgba(255,255,255,0.4);
    text-decoration: none; text-transform: uppercase; letter-spacing: 0.06em;
    transition: color 0.2s; white-space: nowrap;
    min-height: 44px;
  }
  .t10-view-all:hover { color: #fff; }
  .t10-view-all svg { transition: transform 0.2s; }
  .t10-view-all:hover svg { transform: translateX(3px); }

  /* ── Viewport — the scrolling container ── */
  .t10-viewport {
    position: relative;
    overflow-x: hidden;
    overflow-y: visible;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .t10-viewport::-webkit-scrollbar { display: none; }

  /* ── Track — single row of items ── */
  .t10-track {
    display: flex;
    gap: 0;
    padding-bottom: 0.75rem;
    padding-top: 1rem;
    padding-left: 0.25rem;
  }

  /* ── Each item ──
     The poster takes whatever space the rank column leaves (`flex: 1`), and the
     overlap is a negative margin on the rank expressed in `em` of the rank's
     own font-size. A digit in this face advances ~0.5em, so -0.05em hides ~10%
     of it and ~90% stays visible — identically on mobile and desktop, whatever
     the font-size clamp resolves to. */
  .t10-item {
    --t10-overlap: 0.05em;
    position: relative;
    display: flex;
    align-items: flex-end;
    flex: 0 0 calc(100% / 5);
    min-width: calc(100% / 5);
    transition: opacity 0.3s ease;
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .t10-header {
      padding-left: 0;
      padding-right: 0;
    }

    .t10-track {
      padding-left: 0;
      padding-right: 0;
      padding-top: 1.25rem;
      padding-bottom: 1rem;
      gap: 0;
    }

    /* Each item: ~2 visible + peek of 3rd */
    .t10-item {
      flex: 0 0 calc(100vw / 2.2) !important;
      min-width: calc(100vw / 2.2) !important;
    }

    .t10-title { font-size: clamp(0.9375rem, 2.8vw, 1.125rem) !important; }

    /* Rank number */
    .t10-rank {
      font-size: clamp(5rem, 20vw, 7.5rem) !important;
      text-align: right;
      -webkit-text-stroke: 2.5px rgba(255,255,255,0.6) !important;
      opacity: 0.85 !important;
      flex-shrink: 0;
    }

    /* Card */
    .t10-card {
      border-radius: 10px !important;
    }
  }

  /* ── Giant outlined rank number (z-index 0 = BEHIND card) ── */
  .t10-rank {
    position: relative;
    z-index: 0;
    flex-shrink: 0;
    /* Wide enough for the two-digit "10" at any font-size. A right-aligned
       line that overflows its box is not pushed left by `text-align` in Chrome
       — it spills to the right, straight under the poster, which is why rank 10
       used to be half-hidden while 1–9 were fine. Sizing the column in `em`
       keeps every rank inside its box. */
    width: 1.06em;
    font-size: clamp(5.5rem, 9vw, 8.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    text-align: right;
    color: transparent;
    -webkit-text-stroke: 3px rgba(255,255,255,0.55);
    paint-order: stroke fill;
    opacity: 0.7;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.8));
    user-select: none;
    align-self: flex-end;
    margin-bottom: 0.15rem;
    /* Overlap lives here so it scales with the number's own font-size. */
    margin-right: calc(var(--t10-overlap) * -1);
  }
  @media (min-width: 768px)  { .t10-rank { font-size: clamp(6rem, 8vw, 8.5rem); } }
  @media (min-width: 1280px) { .t10-rank { font-size: 9rem; } }

  /* The outline is white, which is invisible on the light theme's near-white
     background — the number was technically "behind the poster" but also
     behind nothing you could see. */
  :global(html[data-theme='light']) .t10-rank {
    -webkit-text-stroke-color: rgba(0, 0, 0, 0.32);
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
    opacity: 0.85;
  }

  /* ── Poster card ── */
  .t10-card {
    position: relative;
    z-index: 1;
    display: block;
    /* Takes the space the rank column leaves, so rank width + overlap can
       change freely without the item overflowing. */
    flex: 1 1 auto;
    min-width: 0;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-surface-2);
    box-shadow: -4px 0 18px rgba(0,0,0,0.6), 0 4px 16px rgba(0,0,0,0.45);
    transition: transform 0.22s cubic-bezier(0.16,1,0.3,1), box-shadow 0.22s ease;
  }
  .t10-card:hover {
    transform: scale(1.06) translateY(-5px);
    box-shadow: -4px 0 18px rgba(0,0,0,0.6), 0 12px 32px rgba(0,0,0,0.7);
  }

  .t10-poster {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }
  .t10-poster--empty {
    aspect-ratio: 2 / 3;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-surface-2); color: var(--color-text-3);
  }

  /* Hover overlay */
  .t10-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.28) 55%, transparent 100%);
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 0.5rem 0.45rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .t10-card:hover .t10-card-overlay,
  .t10-card:focus-visible .t10-card-overlay { opacity: 1; }

  .t10-rating {
    display: inline-flex; align-items: center; gap: 0.2rem;
    font-size: 0.6875rem; font-weight: 700; color: #f5c518; margin-bottom: 0.2rem;
  }
  .t10-name {
    font-size: 0.6875rem; font-weight: 600; color: #fff; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* Reduced motion: disable auto-scroll, show as static overflow */
  @media (prefers-reduced-motion: reduce) {
    .t10-viewport { overflow-x: auto; }
  }
</style>
