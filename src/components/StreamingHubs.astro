---
// StreamingHubs.astro — 4 platform hub cards that auto-scroll horizontally
// Each card shows the platform logo, name, tagline and links to its dedicated page.
---

<section class="hubs-section" aria-label="Streaming platforms">
  <div class="container">
    <div class="hubs-header">
      <h2 class="hubs-title">Browse by Platform</h2>
      <p class="hubs-sub">Dive into your favourite streaming service</p>
    </div>

    <div class="hubs-track" role="list" data-hubs-track>

      <!-- Netflix -->
      <a href="/netflix" class="hub-card hub-card--netflix" role="listitem" aria-label="Browse Netflix">
        <div class="hub-glow" aria-hidden="true"></div>
        <div class="hub-logo" aria-hidden="true">
          <!-- Netflix N wordmark -->
          <svg width="36" height="52" viewBox="0 0 111 190" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 0h28.6l53.6 143.6V0H111v190l-27.7.1-55-147.6V190H0V0z" fill="#e50914"/>
          </svg>
        </div>
        <div class="hub-info">
          <span class="hub-name">Netflix</span>
          <span class="hub-tag">Top 10 Today · Originals · Films</span>
        </div>
        <div class="hub-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <div class="hub-count-badge">Top 10</div>
      </a>

      <!-- Prime Video -->
      <a href="/prime" class="hub-card hub-card--prime" role="listitem" aria-label="Browse Prime Video">
        <div class="hub-glow" aria-hidden="true"></div>
        <div class="hub-logo" aria-hidden="true">
          <!-- Prime arrow + smile mark -->
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
            <rect width="44" height="44" rx="10" fill="#00A8E0"/>
            <text x="50%" y="58%" dominant-baseline="middle" text-anchor="middle" font-size="22" font-weight="900" font-family="Arial,sans-serif" fill="#fff">P</text>
            <path d="M10 33 Q22 40 34 33" stroke="#fff" stroke-width="2.5" stroke-linecap="round" fill="none"/>
          </svg>
        </div>
        <div class="hub-info">
          <span class="hub-name">Prime Video</span>
          <span class="hub-tag">Exclusives · Movies · Series</span>
        </div>
        <div class="hub-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <div class="hub-count-badge">Top 10</div>
      </a>

      <!-- Hotstar -->
      <a href="/hotstar" class="hub-card hub-card--hotstar" role="listitem" aria-label="Browse Hotstar">
        <div class="hub-glow" aria-hidden="true"></div>
        <div class="hub-logo" aria-hidden="true">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
            <rect width="44" height="44" rx="10" fill="url(#hs-grad)"/>
            <text x="50%" y="57%" dominant-baseline="middle" text-anchor="middle" font-size="13" font-weight="900" font-family="Arial,sans-serif" fill="#fff">HS</text>
            <defs>
              <linearGradient id="hs-grad" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                <stop stop-color="#1F80E0"/><stop offset="1" stop-color="#0052CC"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="hub-info">
          <span class="hub-name">Hotstar</span>
          <span class="hub-tag">Sports · Bollywood · Star</span>
        </div>
        <div class="hub-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <div class="hub-count-badge">Top 10</div>
      </a>


    </div>
  </div>
</section>

<script>
  // Auto-scroll the hub cards slowly, pause on hover
  const track = document.querySelector<HTMLElement>('[data-hubs-track]');
  if (track) {
    let paused = false;
    let pos = 0;
    let raf = 0;

    const step = () => {
      if (!paused) {
        pos += 0.5;
        if (pos >= track.scrollWidth - track.clientWidth) pos = 0;
        track.scrollLeft = pos;
      }
      raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);

    track.addEventListener('mouseenter', () => { paused = true; });
    track.addEventListener('mouseleave', () => { paused = false; pos = track.scrollLeft; });
    track.addEventListener('touchstart',  () => { paused = true; }, { passive: true });
    track.addEventListener('touchend',    () => { paused = false; pos = track.scrollLeft; });

    // Cleanup on Astro view transitions
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  }
</script>

<style>
  .hubs-section {
    margin-bottom: 0.5rem;
  }

  .hubs-header {
    margin-bottom: 1.25rem;
    padding: 0 0.25rem;
  }

  .hubs-title {
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
    margin: 0 0 0.2rem;
    line-height: 1.2;
  }

  .hubs-sub {
    font-size: 0.8125rem;
    color: var(--color-text-3);
    margin: 0;
  }

  /* Scrolling track */
  .hubs-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: default;
  }
  .hubs-track::-webkit-scrollbar { display: none; }

  /* Hub card */
  .hub-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
    width: 280px;
    padding: 1.25rem 1.125rem;
    border-radius: 14px;
    text-decoration: none;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: var(--color-surface);
    transition: transform 0.22s cubic-bezier(0.16,1,0.3,1), box-shadow 0.22s ease, border-color 0.2s;
  }

  @media (min-width: 768px) { .hub-card { width: 300px; } }

  .hub-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 16px 40px rgba(0,0,0,0.5);
  }

  /* Glow blob behind content */
  .hub-glow {
    position: absolute;
    top: -40px; right: -40px;
    width: 130px; height: 130px;
    border-radius: 50%;
    filter: blur(50px);
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .hub-card:hover .hub-glow { opacity: 0.55; }

  /* Per-platform colour overrides */
  .hub-card--netflix  { border-color: rgba(229,9,20,0.2); }
  .hub-card--netflix:hover { border-color: rgba(229,9,20,0.5); box-shadow: 0 16px 40px rgba(229,9,20,0.2); }
  .hub-card--netflix .hub-glow  { background: #e50914; }

  .hub-card--prime    { border-color: rgba(0,168,224,0.2); }
  .hub-card--prime:hover  { border-color: rgba(0,168,224,0.5); box-shadow: 0 16px 40px rgba(0,168,224,0.2); }
  .hub-card--prime .hub-glow    { background: #00a8e0; }

  .hub-card--disney   { border-color: rgba(17,60,207,0.25); }
  .hub-card--disney:hover { border-color: rgba(17,60,207,0.5); box-shadow: 0 16px 40px rgba(17,60,207,0.25); }
  .hub-card--disney .hub-glow   { background: #113ccf; }

  .hub-card--hotstar  { border-color: rgba(31,128,224,0.2); }
  .hub-card--hotstar:hover { border-color: rgba(31,128,224,0.5); box-shadow: 0 16px 40px rgba(31,128,224,0.2); }
  .hub-card--hotstar .hub-glow  { background: #1f80e0; }

  .hub-card--anime    { border-color: rgba(244,114,182,0.2); }
  .hub-card--anime:hover { border-color: rgba(244,114,182,0.5); box-shadow: 0 16px 40px rgba(244,114,182,0.2); }
  .hub-card--anime .hub-glow    { background: #f472b6; }

  /* Logo box */
  .hub-logo {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    position: relative;
    z-index: 1;
  }

  /* Info */
  .hub-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .hub-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .hub-tag {
    font-size: 0.75rem;
    color: var(--color-text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Arrow */
  .hub-arrow {
    flex-shrink: 0;
    color: var(--color-text-3);
    position: relative;
    z-index: 1;
    transition: color 0.2s, transform 0.2s;
  }
  .hub-card:hover .hub-arrow { color: var(--color-text); transform: translateX(3px); }

  /* "Top 10" badge */
  .hub-count-badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
  }
</style>
