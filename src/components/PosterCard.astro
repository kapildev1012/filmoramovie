---
// PosterCard.astro — Premium poster card for movie/series grids and rails
export interface Props {
  id: number;
  title: string;
  mediaType: 'movie' | 'tv';
  posterPath: string | null;
  backdropPath?: string | null;
  releaseDate?: string;
  voteAverage?: number;
  overview?: string;
  /** If true, renders wider (backdrop aspect) instead of poster aspect */
  wide?: boolean;
}

const {
  id,
  title,
  mediaType,
  posterPath,
  backdropPath,
  releaseDate,
  voteAverage,
  wide = false,
} = Astro.props;

const TMDB_IMG = 'https://image.tmdb.org/t/p';
const imagePath = wide ? backdropPath : posterPath;
const imageSize = wide ? 'w780' : 'w500';
const imageUrl = imagePath ? `${TMDB_IMG}/${imageSize}${imagePath}` : null;
const posterUrl = posterPath ? `${TMDB_IMG}/w500${posterPath}` : null;
const href = mediaType === 'movie' ? `/movie/${id}` : `/series/${id}`;
const year = releaseDate?.slice(0, 4);
const rating = voteAverage ? Math.round(voteAverage * 10) / 10 : null;
// Simple quality heuristic for a premium badge.
const quality = rating !== null && rating >= 8 ? '4K' : 'HD';
---

<article class={`poster-card ${wide ? 'poster-card--wide' : ''}`}>
  <div class="poster-card-img-wrap">
    <!-- Stretched cover link (whole card is clickable) -->
    <a href={href} class="poster-card-cover" aria-label={`${title}${year ? ` (${year})` : ''}`}></a>

    {imageUrl ? (
      <img
        src={imageUrl}
        alt=""
        class="poster-card-img"
        loading="lazy"
        decoding="async"
        width={wide ? 780 : 500}
        height={wide ? 439 : 857}
      />
    ) : (
      <div class="poster-card-placeholder" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
        </svg>
        <span class="poster-card-placeholder-text">{title}</span>
      </div>
    )}

    <!-- Hover overlay with actions -->
    <div class="poster-card-overlay">
      <div class="poster-card-meta">
        {year && <span class="pc-year">{year}</span>}
        <span class={`pc-type ${mediaType === 'movie' ? 'pc-type--movie' : 'pc-type--tv'}`}>
          {mediaType === 'movie' ? 'Movie' : 'Series'}
        </span>
      </div>
      <div class="poster-card-actions">
        <a href={href} class="pc-btn pc-btn--play" aria-label={`Play ${title}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </a>
        <button
          type="button"
          class="pc-btn pc-fav"
          data-id={id}
          data-type={mediaType}
          data-title={title}
          data-poster={posterUrl}
          aria-label={`Add ${title} to favorites`}
          aria-pressed="false"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        </button>
        <a href={href} class="pc-btn pc-btn--info" aria-label={`Details for ${title}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Badges sit OUTSIDE the scaling wrap — they stay fixed during hover -->
  <div class="poster-card-badges" aria-hidden="true">
    {rating !== null && rating > 0 && (
      <span class="pc-imdb"><span class="pc-imdb-tag">IMDb</span>{rating.toFixed(1)}</span>
    )}
    <span class="pc-quality">{quality}</span>
  </div>

  <div class="poster-card-info">
    <h3 class="poster-card-title">{title}</h3>
    {year && <span class="poster-card-subtitle">{year}</span>}
  </div>
</article>

<script>
  // Delegated favorite toggling (bundled once by Astro, shared by all cards).
  const WL_KEY = 'filmora_watchlist';
  type WL = { id: number; mediaType: string; title: string; posterUrl: string | null; addedAt: string };

  function readWL(): WL[] {
    try { return JSON.parse(localStorage.getItem(WL_KEY) || '[]'); } catch { return []; }
  }
  function syncFavs() {
    const wl = readWL();
    document.querySelectorAll<HTMLButtonElement>('.pc-fav').forEach((btn) => {
      const id = Number(btn.dataset.id);
      const type = btn.dataset.type;
      const saved = wl.some((i) => i.id === id && i.mediaType === type);
      btn.setAttribute('aria-pressed', String(saved));
      btn.classList.toggle('pc-fav--on', saved);
    });
  }
  function onClick(e: MouseEvent) {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.pc-fav');
    if (!btn) return;
    e.preventDefault();
    const id = Number(btn.dataset.id);
    const type = btn.dataset.type as string;
    const wl = readWL();
    const idx = wl.findIndex((i) => i.id === id && i.mediaType === type);
    if (idx >= 0) wl.splice(idx, 1);
    else wl.push({ id, mediaType: type, title: btn.dataset.title || '', posterUrl: btn.dataset.poster || null, addedAt: new Date().toISOString() });
    try { localStorage.setItem(WL_KEY, JSON.stringify(wl)); } catch {}
    syncFavs();
  }

  document.addEventListener('click', onClick);
  document.addEventListener('astro:page-load', syncFavs);
  syncFavs();
</script>

<style>
  .poster-card {
    flex-shrink: 0;
    width: 200px;
    position: relative; /* needed so badges can absolute-position to card */
    /* Apple "liquid glass" frame — a translucent black pane with a frosted
       blur and a hairline highlight, wrapping the artwork and its caption.
       The padding is the visible glass border; the artwork sits inside it. */
    padding: 0.4rem 0.4rem 0.1rem;
    border-radius: var(--radius-xl);
    background: rgba(8, 8, 10, 0.42);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10),
                inset 0 0 0 1px rgba(255, 255, 255, 0.02),
                0 8px 24px rgba(0, 0, 0, 0.38);
    transition: transform 260ms var(--ease-out-fast),
                box-shadow 260ms var(--ease-out-fast),
                border-color 260ms var(--ease-out-fast);
  }
  .poster-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16),
                inset 0 0 0 1px rgba(255, 255, 255, 0.04),
                0 22px 46px rgba(0, 0, 0, 0.55),
                0 0 34px rgba(161, 66, 244, 0.28);
  }
  .poster-card--wide { width: 320px; }

  .poster-card-img-wrap {
    position: relative;
    /* Inner radius slightly tighter than the glass frame so the corners nest. */
    border-radius: calc(var(--radius-xl) - 0.35rem);
    overflow: hidden;
    /* Transparent surface: the artwork is the card. A filled panel behind it
       showed as a grey slab wherever the poster is missing, still loading, or
       has transparency, and it fought the section backgrounds the rails sit on.
       The placeholder below carries its own surface for the no-artwork case. */
    background: transparent;
    aspect-ratio: 7/12;
    transition: transform 260ms var(--ease-out-fast), box-shadow 260ms var(--ease-out-fast);
  }
  .poster-card--wide .poster-card-img-wrap { aspect-ratio: 16/9; }

  /* Lift lives on the glass frame now, so the wrap itself no longer moves. */

  .poster-card-cover { position: absolute; inset: 0; z-index: 1; }

  .poster-card-img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 400ms var(--ease-out-fast);
  }
  .poster-card:hover .poster-card-img { transform: scale(1.06); }

  .poster-card-placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.75rem; padding: 1rem; color: var(--color-text-3);
    /* The one case that needs a surface — an empty transparent box with a glyph
       floating in it reads as a layout bug. */
    background: rgba(255,255,255,0.05);
  }
  .poster-card-placeholder-text { font-size: var(--font-size-xs); text-align: center; color: var(--color-text-3); line-height: 1.3; }

  /* Badges — outside the scaling wrap, fixed to card top */
  .poster-card-badges {
    position: absolute;
    top: 0.75rem; left: 0.75rem; right: 0.75rem;
    z-index: 10;
    display: flex; align-items: center; justify-content: space-between; gap: 0.25rem;
    pointer-events: none;
  }
  .pc-imdb {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-size: 0.7rem; font-weight: 700; color: #fff;
    background: rgba(0,0,0,0.55); padding: 0.15rem 0.4rem; border-radius: var(--radius-sm);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .pc-imdb-tag { background: #f5c518; color: #000; font-weight: 800; font-size: 0.6rem; padding: 0.05rem 0.25rem; border-radius: 3px; }
  .pc-quality {
    font-size: 0.6rem; font-weight: 800; letter-spacing: 0.04em; color: #fff;
    background: rgba(0,0,0,0.55); padding: 0.15rem 0.4rem; border-radius: var(--radius-sm);
    border: 1px solid rgba(255,255,255,0.2);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }

  /* Hover overlay */
  .poster-card-overlay {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.35) 55%, transparent 100%);
    opacity: 0; transition: opacity 220ms ease;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 0.75rem; gap: 0.5rem;
    pointer-events: none;
  }
  .poster-card:hover .poster-card-overlay,
  .poster-card:focus-within .poster-card-overlay { opacity: 1; }

  .poster-card-meta { display: flex; align-items: center; gap: 0.375rem; flex-wrap: wrap; }
  .pc-year { font-size: 0.75rem; color: rgba(255,255,255,0.7); }
  .pc-type {
    font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    padding: 0.1rem 0.375rem; border-radius: var(--radius-full); border: 1px solid;
  }
  .pc-type--movie { color: #4285F4; border-color: rgba(66,133,244,0.5); }
  .pc-type--tv { color: #A142F4; border-color: rgba(161,66,244,0.5); }

  .poster-card-actions { display: flex; align-items: center; gap: 0.5rem; pointer-events: auto; }
  .pc-btn {
    width: 38px; height: 38px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid rgba(255,255,255,0.25); background: rgba(255,255,255,0.1);
    color: #fff; cursor: pointer; text-decoration: none;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: transform 160ms var(--ease-out-fast), background 160ms ease, border-color 160ms ease;
  }
  .pc-btn:hover { transform: scale(1.12); background: rgba(255,255,255,0.2); }
  .pc-btn--play { background: linear-gradient(135deg, var(--color-accent-from), var(--color-accent-to)); border-color: transparent; }
  .pc-fav--on { color: #ff4d6d; border-color: #ff4d6d; }
  .pc-fav--on svg { fill: #ff4d6d; }

  /* Below image — sits on the glass frame, aligned to the artwork edges. */
  .poster-card-info { padding: 0.55rem 0.15rem 0.3rem; }
  .poster-card-title {
    font-size: var(--font-size-sm); font-weight: 500; color: var(--color-text);
    margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.3;
  }
  .poster-card-subtitle { display: block; font-size: var(--font-size-xs); color: var(--color-text-3); margin-top: 0.125rem; }

  /* Grid context */
  /* In a grid the card fills its cell. The min/max-width the horizontal rails
     set (see mobile.css) must be cleared here, or on a phone a grid card gets
     capped narrower than its track (leaving ragged gaps) or forced wider than
     its 1fr track (overflowing the row) — either way the cards stop looking
     uniform. `width:100%` + `min-width:0` + `max-width:none` makes every grid
     card exactly one track wide. */
  :global(.poster-grid) .poster-card { width: 100%; min-width: 0; max-width: none; flex-shrink: unset; }
  :global(.poster-grid) .poster-card--wide { width: 100%; max-width: none; }
  /* Reserve the subtitle line so cards with no release year are the same height
     as cards that show one — the grid rows then align perfectly. */
  :global(.poster-grid) .poster-card-info { min-height: 2.6rem; }

  /* Touch/mobile: no hover UI — hide the action overlay (play / heart / info)
     and disable the sticky-hover lift + zoom so cards stay static on tap.
     With the wrap transparent, the drop shadow has nothing to sit on at this
     size (rails put cards ~110px wide side by side and the shadows merged into
     a grey band), so it becomes a hairline edge instead. Badges shrink to match
     the smaller artwork — at 0.7rem they covered a third of the poster. */
  @media (max-width: 767px) {
    /* Lighter glass on a phone: a big backdrop-blur behind ~110px cards packed
       into a rail is expensive and the frame reads heavy, so trim the padding
       and radius and drop the hover lift/zoom (there is no hover on touch). */
    .poster-card {
      padding: 0.3rem 0.3rem 0.05rem;
      border-radius: var(--radius-lg);
    }
    .poster-card:hover,
    .poster-card:focus-within {
      transform: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10),
                  0 6px 18px rgba(0, 0, 0, 0.35);
      border-color: rgba(255, 255, 255, 0.09);
    }
    .poster-card-overlay { display: none !important; }
    .poster-card:hover .poster-card-img { transform: none; }

    .poster-card-badges { top: 0.55rem; left: 0.55rem; right: 0.55rem; gap: 0.2rem; }
    .pc-imdb { font-size: 0.625rem; padding: 0.1rem 0.3rem; gap: 0.2rem; }
    .pc-imdb-tag { font-size: 0.5rem; }
    .pc-quality { font-size: 0.5rem; padding: 0.1rem 0.3rem; }
    .poster-card-info { padding: 0.4rem 0.1rem 0.2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-card:hover { transform: none; }
    .poster-card:hover .poster-card-img { transform: none; }
  }
</style>
